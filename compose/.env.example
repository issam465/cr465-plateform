# Modèle de configuration. NE PAS mettre de vrais secrets ici.
# Sur la VM, lancer scripts/gen-secrets.sh : il crée .env avec des mots de passe aléatoires.

# Domaine local (résolu par le fichier hosts du poste client)
DOMAIN=cr465.test

# IP autorisées pour les interfaces d'administration (Traefik, Portainer)
# 10.0.2.2 = poste Windows vu depuis une VM VirtualBox en NAT
ADMIN_ALLOWLIST=10.0.2.2/32,127.0.0.1/32

# PostgreSQL : super-utilisateur + un mot de passe par service
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=changeme
DRUPAL_DB_PASSWORD=changeme
MOODLE_DB_PASSWORD=changeme
KEYCLOAK_DB_PASSWORD=changeme
N8N_DB_PASSWORD=changeme

# Keycloak : compte d'administration initial (realm master)
KEYCLOAK_ADMIN_PASSWORD=changeme
